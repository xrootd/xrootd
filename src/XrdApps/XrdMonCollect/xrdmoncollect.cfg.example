# Example xrdmoncollect configuration file.
#
# Loaded with `xrdmoncollect -c <file>`, or automatically from
# /etc/xrootd/xrdmoncollect.cfg when that file exists. All keys live in a single
# [xrdmoncollect] section and mirror the long command-line option names.
# Command-line options override values set here. Lines starting with # or ; are
# comments.

[xrdmoncollect]

# UDP port to listen on (same as -p / --udp-port; required unless tcp-port is
# set). The udp-port key is an accepted alias. Under systemd with the
# xrdmoncollect.socket unit enabled, sockets matching these ports are
# inherited from systemd (socket activation) and stay open across service
# restarts for zero-loss restarts; keep the ports here and in the socket
# unit in sync.
port = 9930

# Address to bind (default: all interfaces, dual-stack). Same as -b.
# bind = 0.0.0.0

# Also accept UDP packets encapsulated over TCP from remote xrdmoncollect
# instances running in shoveler mode (see the shovel key below), optionally
# requiring a shared-secret token in the connection hello. A token of the form
# @<file> is read from that file. With tcp-port set, port/-p is optional (a
# TCP-only central collector).
# tcp-port = 9931
# tcp-token = @/etc/xrootd/shovel.token

# Shoveler mode: instead of decoding, relay the received UDP packets over TCP
# to a central collector's tcp-port (host:port). Decode/sink options are
# ignored (with a warning) in this mode, so shovelers and the central
# collector can share this file. While the collector is unreachable, framed
# buffers spool under <cache-dir>/shovel, capped by spool-max (K/M/G suffix;
# 0 = unbounded), evicting the oldest buffers when full.
# shovel = collector.example.org:9931
# shovel-token = @/etc/xrootd/shovel.token
# spool-max = 1G

# Append decoded documents to this file (default: stdout unless an OpenSearch or
# forward sink is configured). Same as -o.
# output = /var/log/xrootd/moncollect.ndjson

# Write the file/stdout sink in OpenSearch _bulk format for this index.
# bulk = xrootd-transfers

# Post documents to an OpenSearch cluster's _bulk API. Authenticate with either
# basic auth (os-user/os-pass) or a bearer token (os-token, sent as
# "Authorization: Bearer <token>"); the token wins if both are set. A token of
# the form @<file> is read from that file so it does not appear in ps/argv.
# os-url = https://opensearch.example.org:9200
# os-index = xrootd-transfers
# os-user = collector
# os-pass = secret
# os-token = @/etc/xrootd/opensearch.token
# os-insecure = false
# os-datastream = false

# Export as OTLP/JSON to an OpenTelemetry collector (Alloy / OTel Collector):
# logs to <url>/v1/logs and, with spans = true, traces to <url>/v1/traces.
# Optional bearer token (Authorization: Bearer); @<file> reads it from a file.
# otlp-url = http://collector.example.org:4318
# otlp-token = @/etc/xrootd/otlp.token
# otlp-insecure = false

# On-failure disk cache (shared by the OpenSearch and OTLP sinks): bodies that
# fail to POST are written here and retried oldest-first (and replayed on
# startup). OpenSearch bulk bodies live directly under the dir; OTLP bodies under
# otlp-logs/ and otlp-traces/. Unset = drop on failure.
# cache-dir = /var/lib/xrootd/moncollect

# Also stream documents as NDJSON over TCP to a buffering frontend (host:port).
# forward = logstash.example.org:5044

# Receive batching: packets per batch (one batch -> one _bulk POST) and the max
# age of a partial batch in seconds.
# flush-count = 500
# flush-secs = 5

# Kernel UDP receive buffer (SO_RCVBUF; K/M/G suffix) and the number of packet
# batches in flight between the receiver and serializer threads.
# rcvbuf = 16M
# queue-depth = 64

# Serve aggregated Prometheus metrics over HTTP on this port (0 = disabled).
# metrics-port = 9931

# Bound correlation state to ~this many bytes (K/M/G/T suffix; 0 = unbounded),
# with an optional hard entry cap and an idle-incarnation reap age in seconds.
# max-memory = 256M
# max-entries = 0
# server-ttl = 86400

# Correlation-state persistence: save the state to this file on shutdown and
# reload it on startup, so a clean restart does not open a blind window while
# the dictionaries repopulate. A snapshot older than state-ttl (s/m/h/d
# suffix) is discarded. Under systemd the file defaults into the service's
# StateDirectory ($STATE_DIRECTORY/xrdmoncollect-state.json); an explicitly
# empty state-file disables persistence.
# state-file = /var/lib/xrootd/xrdmoncollect-state.json
# state-ttl = 15m

# SciTags registry (a file path or http(s):// URL) and its refresh interval.
# scitags = /etc/xrootd/scitags.json
# scitags-refresh = 3600

# Dataset capture: a POSIX extended regex whose first capture group, matched
# against each file path, is emitted as the xrootd.dataset attribute (feeds
# the data-popularity dashboards). Matched once per emitted document; keep
# the pattern anchored and simple. Example for a CMS-style namespace
# (/store/<class>/<era>/<primary-dataset>/...):
# dataset = ^/store/[^/]+/[^/]+/([^/]+)/

# Do not substitute the local FQDN for a loopback (co-located) server.
# no-resolve = false

# Correlate per-session activity and emit a session document per client
# disconnect (off by default; adds a bounded per-session rollup).
# sessions = false

# Opt-in extra document streams (high volume; off by default).
# traces = false
# gstream = false
# redirects = false

# Debugging: also emit one JSON object per decoded record; print stats on exit.
# dump = false
# verbose = false
