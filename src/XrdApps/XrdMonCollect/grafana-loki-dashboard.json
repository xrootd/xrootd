  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "refresh": "30s",
  "schemaVersion": 39,
  "style": "dark",
  "tags": [
    "xrootd",
    "xrdmoncollect",
    "loki"
  ],
  "templating": {
    "list": [
      {
        "name": "DS_LOKI",
        "type": "datasource",
        "label": "Loki",
        "query": "loki",
        "current": {},
        "hide": 0,
        "refresh": 1
      },
      {
        "name": "server",
        "type": "query",
        "label": "Server",
        "datasource": {
          "type": "loki",
          "uid": "${DS_LOKI}"
        },
        "definition": "label_values({service_name=\"xrootd\"}, service_instance_id)",
        "query": {
          "label": "service_instance_id",
          "stream": "{service_name=\"xrootd\"}",
          "type": 1,
          "refId": "server"
        },
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
